# Documentation template only; the app does not auto-load this file.
# Set the real token only in the server environment. Never commit it.
HF_TOKEN=
HF_LLM_MODEL=Qwen/Qwen3-32B
HF_LLM_PROVIDER=deepinfra
MEDSPEECH_REVIEW_BACKEND=hf
MEDSPEECH_MODE=full
# Set an absolute path with Resolve-Path as shown in README before starting full server.
HF_CLIENT_PYTHON=
