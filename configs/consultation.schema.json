{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "value",
        "evidence"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "value",
        "evidence",
        "unit"
      ],
      "title": "Measurement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "purpose": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "symptoms": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Symptoms",
      "type": "array"
    },
    "denied_symptoms": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Denied Symptoms",
      "type": "array"
    },
    "medications": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Medications",
      "type": "array"
    },
    "measurements": {
      "items": {
        "$ref": "#/$defs/Measurement"
      },
      "title": "Measurements",
      "type": "array"
    }
  },
  "title": "Consultation",
  "type": "object"
}